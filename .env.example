NODE_ENV=production

FRONTEND_PORT=8080
FRONTEND_DEV_PORT=5173
BACKEND_PORT=3000
MONGO_PORT=27017
VALKEY_PORT=6379
REDIS_INSIGHT_PORT=5540

MONGO_INITDB_ROOT_USERNAME=admin
